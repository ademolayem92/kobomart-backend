# ==============================================================================
# KoboMarket Environment Configuration Template
# Duplicate this file as '.env' and populate with your local/production values.
# ==============================================================================

# --- Server Core Settings ---
PORT=3000
NODE_ENV=development

# --- Security & Authentication Tokens ---
# Generate strong secrets using 'openssl rand -base64 32'
JWT_SECRET=your_super_secret_access_token_key_change_me
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_me

# --- Database Connection Parameters ---
# MongoDB Connection String (Handles catalog, profiles, carts, reviews)
MONGODB_URI=mongodb://localhost:27017/kobomarket

# PostgreSQL Connection String (Handles ledger entries, wallets, orders, payouts)
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kobomarket

# --- Payment Processor Integrations (Paystack Test Mode) ---
# Obtain these from your Paystack Dashboard Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Platform Financial Policies ---
# Base platform commission rate represented as a percentage (e.g., 5 = 5%)
PLATFORM_COMMISSION_PERCENT=5

# --- Background Worker / Cron Settings ---
# Frequency of the auto-completion background task checking for expired shipments (in minutes)
AUTO_COMPLETE_CHECK_INTERVAL_MINUTES=15
